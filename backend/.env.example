PORT=5000

HOST=0.0.0.0

FLASK_DEBUG=true

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_CONTENT_LENGTH_BYTES=65536

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_TIMEOUT_SECONDS=12.0

# Where traffic/congestion/routing state is persisted -- a real
# SQLite database, not a flat file. Defaults to backend/data/state.db.
STATE_DB_PATH=

# Comma-separated API keys required as `Authorization: Bearer <key>`
# on every /api/* route except /api/health. Leave blank (default) to
# run with no auth, same as before this existed -- set this before
# exposing the API beyond localhost.
API_KEYS=

# Background live-connection scanning: periodically checks your real
# network connections and adds new ones as traffic automatically (no
# need to call POST /api/traffic/scan by hand). On by default -- it
# only reads local connection info, never touches the network.
SCAN_POLL_ENABLED=true
SCAN_POLL_INTERVAL_SECONDS=5

# Live TLS SNI sniffing: reads the real hostname straight out of
# HTTPS handshakes instead of relying on reverse DNS (which fails for
# big platforms -- YouTube resolves to a generic Google hostname, not
# "youtube.com"). Off by default: needs raw packet access, same
# privilege level as running `tcpdump` (sudo on Mac/Linux, admin on
# Windows). Run the server with elevated privileges to use this.
SNI_SNIFF_ENABLED=false
# Interface to sniff on (e.g. en0 on Mac Wi-Fi, eth0 on Linux). Leave
# blank to auto-detect your default network interface.
SNI_SNIFF_INTERFACE=

# Directory POST /api/capture/analyze is allowed to read .pcap files
# from -- requests for a path outside this directory are rejected.
# Defaults to backend/data/captures/. Requires `scapy` (see
# requirements.txt) -- without it, that one endpoint returns 501.
CAPTURES_DIR=

# Max flows a single /api/capture/analyze call will process, ranked by
# packet count. Keeps a huge pcap from becoming thousands of Gemini calls.
CAPTURE_MAX_FLOWS=25

# Real traffic shaping (POST /api/enforce/apply, services/enforcement_service.py).
# false (default) = every enforcement call is a dry run: it returns the
# tc/iptables commands it would run without touching the network.
# Only set true once you deliberately mean to reconfigure a real
# interface -- this is a genuine safety default, not just for dev.
ENFORCEMENT_ENABLED=false

# Interface enforcement rules apply to. "lo" (default) never carries
# real external traffic, so it's safe to leave this enabled against by
# accident. Set to a real interface (e.g. eth0) only when you actually
# want to shape traffic on it.
ENFORCEMENT_INTERFACE=lo

# Total bandwidth (Mbps) the priority tiers divide up.
ENFORCEMENT_BANDWIDTH_MBPS=10
