# Copy this file to .env and adjust as needed. All values are optional;
# sensible defaults are used if omitted.

# Port the Flask dev server listens on.
PORT=5000

# Host interface to bind to.
HOST=0.0.0.0

# Enable Flask debug mode (auto-reload + verbose errors in the console).
# Keep "true" for hackathon development, set "false" for a live demo
# if you don't want the debugger page on errors.
FLASK_DEBUG=true

# Comma-separated list of frontend origins allowed to call this API
# (CORS). Add your dashboard's dev server URL here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum accepted request body size, in bytes.
MAX_CONTENT_LENGTH_BYTES=65536

# Optional. If set, POST /api/classify and traffic creation use real
# Gemini semantic analysis (services/gemini_service.py,
# services/semantic_service.py) instead of the deterministic fallback.
# Leave unset to keep using the fallback -- nothing else changes, and
# the app is fully functional without this key.
GEMINI_API_KEY=

# Gemini model used for semantic analysis. gemini-3.5-flash-lite is
# fast/cheap and appropriate for structured classification.
GEMINI_MODEL=gemini-3.5-flash-lite

# Hard timeout (seconds) for a single Gemini call before falling back.
# Must be >= 10 -- the Gemini API server rejects any shorter deadline
# outright (400 INVALID_ARGUMENT), regardless of API key validity.
GEMINI_TIMEOUT_SECONDS=12.0
